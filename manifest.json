{
  "manifest_version": 3,
  "name": "Referral Scout — Jobs, Referrals & Autofill",
  "short_name": "Ref Scout",
  "version": "0.60.0",
  "description": "Find jobs matching your CV, rank referrers, draft outreach, and autofill applications—always under your review.",
  "homepage_url": "https://referral-scout.vercel.app",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "sidePanel", "scripting", "tabs", "power", "unlimitedStorage", "contextMenus", "notifications"],
  "host_permissions": ["https://www.linkedin.com/*", "https://linkedin.com/*", "https://chatgpt.com/*", "https://mail.google.com/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Referral Scout"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*", "https://linkedin.com/*", "https://chatgpt.com/*", "https://mail.google.com/*"],
      "js": ["health.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "optional_host_permissions": ["https://api.openai.com/*", "https://media.licdn.com/*", "https://*/*", "http://*/*"]
}
