{
  "manifest_version": 3,
  "name": "Cold Contact \u2014 LinkedIn Outreach",
  "version": "0.13.0",
  "description": "Find recruiters, hiring leaders and founders on LinkedIn, send invitations slowly and safely, and follow up once after they accept.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "sidePanel",
    "scripting",
    "tabs",
    "power"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Cold Contact Pro"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "health.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
